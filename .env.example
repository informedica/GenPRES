# GenPRES Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The .env file is excluded from git (opt-in .gitignore).
# Do NOT commit .env with real values.

# The port Kestrel listens on. The one setting here without the GENPRES_ prefix.
# Unset means 8085, which the Vite dev server proxies to; change both together.
# SERVER_PORT=8085

# Google Sheets data URL ID (required)
# Pre-filled with the public demo sheet, so a copy of this file works as-is in
# demo mode. For production data, ask a team member for the proprietary URL ID
# and replace the value below.
GENPRES_URL_ID=1IZ3sbmrM4W4OuSYELRmCkdxpN9SlBI-5TLSvXWhHVmA

# Logging level: 0=off, d=debug, i=info, w=warning, e=error
GENPRES_LOG=i

# Production mode: 0=demo (safe default), 1=production data
GENPRES_PROD=0

# Debug mode: 0=off, 1=on
GENPRES_DEBUG=1

# Default UI language until the url (`la=`) or the user chooses one.
# ISO code en, nl, fr, de, es, it (any case); unset means nl. Any other value
# refuses the start.
GENPRES_LANG=nl

# Password for admin operations (settings, log analysis, resource reload)
# Left EMPTY on purpose: empty or unset means admin operations are disabled
# (fail-closed). `dotnet run` copies this file to .env on a fresh clone, and
# the copy must not carry a password that is visible in the repository. Set
# a value here only when you need the admin pages locally.
#
# SECURITY POLICY:
#   - Development (GENPRES_PROD=0): any value is accepted, including the
#     trivial "genpres" used by some local setups. Never reuse this in
#     production.
#   - Production (GENPRES_PROD=1): missing or empty means the server starts
#     with admin operations disabled and prints a warning (issue #590); a
#     value shorter than 16 characters REFUSES to start. Generate a strong
#     value with a CSPRNG, e.g.:
#         openssl rand -base64 32
#     and inject it via your secret store (Docker secret, Kubernetes secret,
#     vault, ...). Never commit a real password to the repository.
GENPRES_PASSWORD=

# The reverse proxies whose X-Forwarded-For header is believed, as a comma-separated
# list of IP addresses. Unset means loopback only, which is what a local run and the
# Plesk-to-Kestrel hop on the demo deployments need; set it for a server reached
# through a known proxy fleet. An entry that is not an IP address is dropped, and an
# allow-list that ends up empty believes no forwarded header at all.
# GENPRES_TRUSTED_PROXIES=10.0.0.5, 10.0.0.6

# The directory holding data/ (cache, config, db, logs). Unset means the resolver
# walks up for the folder holding this .env, then for one holding data/zindex, and
# falls back to the current directory with a warning. The image sets it to /app. A
# relative Data Source in GENPRES_DB_CONNECTION below is rooted at it.
# GENPRES_ROOT=/absolute/path/to/checkout

# Session store: a SQLite connection string for the test and development database, which
# keeps the signed order plan versions across a restart. Unset means the in-memory store,
# forgotten at every restart. A relative Data Source is rooted at GENPRES_ROOT when set (/app
# in the image), else at the folder holding this .env, and its folder is created; delete the
# file to start from nothing. Production (GENPRES_PROD=1) refuses to start with it set.
# GENPRES_DB_CONNECTION=Data Source=data/db/genpres.db

# --- Docker Compose only (compose.yaml at the repo root) ---

# Optional: pin a published image tag; see https://hub.docker.com/r/informedica/genpres/tags
# Leave unset to run the current release, whose tag compose.yaml carries as its default.
# The example below is the current release too: ShipIt rewrites both in every release PR,
# so do not hand-edit it.
# GENPRES_IMAGE_TAG=0.1.2-alpha.28

# Host port mapped to the container's 8085
GENPRES_PORT=8080
