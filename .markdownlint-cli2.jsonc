{
    // Markdownlint configuration for GenPRES documentation.
    // See https://github.com/DavidAnson/markdownlint-cli2#configuration
    // Rules reference: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md

    // Exclude vendored/generated content. A bare "node_modules" glob only matches a node_modules 
    // folder at the repo root; "**/node_modules/**" is required to also match the nested one under 
    // src/Informedica.GenPRES.Client/node_modules (see issue #433).
    //
    // The other two are tracked Markdown that nobody writes by hand, so a lint finding in them
    // names no one and can be fixed only by regenerating or recapturing the file:
    //   - BenchmarkDotNet writes its result tables as Markdown. The pre-commit hook already
    //     skips them (.husky/task-runner.json); this makes the build target agree.
    //   - formularium.md and solutions.md beside the NKF and GenFORM scripts are captured
    //     formulary output, Dutch clinical data rather than prose.
    // These apply to a file named on the command line as well as to a glob, so `dotnet run
    // MarkdownLint`, the hook and a bare markdownlint-cli2 all see the same set.
    "ignores": [
        "**/node_modules/**",
        "**/BenchmarkDotNet.Artifacts/**",
        "**/Scripts/formularium.md",
        "**/Scripts/solutions.md"
    ],

    // Markdownlint rule overrides go inside "config".
    "config": {
        // Enable all rules by default, then selectively disable noisy/stylistic ones.
        "default": true,

        // MD013/line-length: Not enforced - project documentation uses long lines.
        "MD013": false,

        // MD024/no-duplicate-heading: Allowed - common in changelogs and structured docs.
        "MD024": false,

        // MD036/no-emphasis-as-heading: Allowed - stylistic choice in some docs.
        "MD036": false,

        // MD012/no-multiple-blanks: Allowed - blank lines used for readability.
        "MD012": false,

        // MD060/fenced-code-block-style: Not enforced - mixed styles in docs.
        "MD060": false,

        // MD010/no-hard-tabs: Allow tabs inside code blocks (TSV samples in
        // data-extraction docs require real tab characters).
        "MD010": { "code_blocks": false },

        // MD033/no-inline-html: EasyBuild.ShipIt closes every release section in
        // CHANGELOG.md with a <strong><small>View changes on Github</small></strong>
        // footer. That output is generated, so allow exactly those two elements.
        "MD033": { "allowed_elements": [ "strong", "small" ] }
    }
}
