<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <!--
    The pure client files: the lane machines and the policies beside them. Plain F# over
    Informedica.GenPRES.Shared, with no React, no Browser type and no Fable package, so the same
    source compiles under Fable for the client and under .NET for the tests. The project boundary
    is what keeps it that way: add a Browser call here and this project stops compiling.
  -->
  <ItemGroup>
    <!-- the rest -->
    <Compile Include="Deferred.fs" />
    <Compile Include="FilterSync.fs" />
    <Compile Include="TermText.fs" />
    <Compile Include="Page.fs" />

    <!-- policies over the contract alone -->
    <Compile Include="LanguagePolicy.fs" />
    <Compile Include="OrderContextRefusalPolicy.fs" />
    <Compile Include="PatientDraftPolicy.fs" />
    <Compile Include="PatientReadiness.fs" />
    <Compile Include="PatientMachine.fs" />
    <Compile Include="PickPolicy.fs" />
    <Compile Include="StepPolicy.fs" />
    <Compile Include="DialogTabPolicy.fs" />
    <Compile Include="SeverityReasonPolicy.fs" />
    <Compile Include="ArgumentationPolicy.fs" />
    <Compile Include="QuantityModePolicy.fs" />
    <Compile Include="IntakePolicy.fs" />
    <Compile Include="FieldOpenPolicy.fs" />
    <Compile Include="PickList.fs" />
    <Compile Include="PlanContextPolicy.fs" />
    <Compile Include="PlanCellPolicy.fs" />
    <Compile Include="SectionFoldPolicy.fs" />
    <Compile Include="TotalsChangePolicy.fs" />
    <Compile Include="PlanWorkPolicy.fs" />
    <Compile Include="HeldContextPolicy.fs" />
    <Compile Include="ServerErrorPolicy.fs" />

    <!-- the session and signing machines -->
    <Compile Include="SessionMachine.fs" />
    <Compile Include="SigningMachine.fs" />

    <!-- policies over the session and signing machines -->
    <Compile Include="SessionGatePolicy.fs" />
    <Compile Include="SigningPolicy.fs" />
    <Compile Include="UnsignedWorkPolicy.fs" />
    <Compile Include="HeldPanelPolicy.fs" />

    <!-- the order machines -->
    <Compile Include="CommandPreview.fs" />
    <Compile Include="OrderPlanMachine.fs" />
    <Compile Include="OrderContextMachine.fs" />

    <!-- the wiring between the machines -->
    <Compile Include="Lanes.fs" />

    <!-- what is out, and what it disables -->
    <Compile Include="Busy.fs" />
    <Compile Include="StartupPolicy.fs" />
    <Compile Include="UrlPolicy.fs" />

    <!-- the readable trail of the machines, for development -->
    <Compile Include="Trail.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Informedica.GenPRES.Shared\Informedica.GenPRES.Shared.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
