<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- temp fix for: https://github.com/fsprojects/Paket/issues/4307 -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The Web SDK otherwise publishes every **/*.json and **/*.config found in the
         project folder. This project has no appsettings and no wwwroot, so that glob
         only ever picked up files that happened to sit in the tree and shipped them
         inside the image. Anything this project needs at run time is declared here. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Logging.fs" />
    <Compile Include="LogAnalyzer.fs" />
    <Compile Include="ServerApi.Mappers.Order.fs" />
    <Compile Include="ServerApi.Ports.fs" />
    <Compile Include="ServerApi.NutritionRuleSets.fs" />
    <Compile Include="ServerApi.Mappers.Patient.fs" />
    <Compile Include="ServerApi.Mappers.OrderContext.fs" />
    <Compile Include="ServerApi.Mappers.OrderPlan.fs" />
    <Compile Include="ServerApi.Mappers.Session.fs" />
    <Compile Include="ServerApi.Services.fs" />
    <Compile Include="ServerApi.Session.fs" />
    <Compile Include="ServerApi.StubAdapters.fs" />
    <Compile Include="ServerApi.SqlAdapters.fs" />
    <Compile Include="ServerApi.Adapters.fs" />
    <Compile Include="ServerApi.Compute.fs" />
    <Compile Include="ServerApi.FormularyCommand.fs" />
    <Compile Include="ServerApi.InteractionCommand.fs" />
    <Compile Include="ServerApi.OrderPlanCommand.fs" />
    <Compile Include="ServerApi.AdminCommand.fs" />
    <Compile Include="ServerApi.OrderContextCommand.fs" />
    <Compile Include="ServerApi.LaunchCommand.fs" />
    <Compile Include="ServerApi.SessionCommand.fs" />
    <Compile Include="ServerApi.SigningCommand.fs" />
    <Compile Include="ServerApi.CompositionRoot.fs" />
    <Compile Include="ServerApi.ApiImpl.fs" />
    <Compile Include="Server.fs" />
    <EmbeddedResource Include="Sql\*.sql" LogicalName="Sql/%(Filename)%(Extension)" />
    <None Include="Scripts\load.fsx" />
    <None Include="Scripts\MemoryStream.fsx" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Informedica.GenPRES.Shared\Informedica.GenPRES.Shared.fsproj" />
    <ProjectReference Include="..\Informedica.GenORDER.Lib\Informedica.GenORDER.Lib.fsproj" />
    <ProjectReference Include="..\Informedica.GenINTERACT.Lib\Informedica.GenINTERACT.Lib.fsproj" />
    <ProjectReference Include="..\Informedica.Agents.Lib\Informedica.Agents.Lib.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>