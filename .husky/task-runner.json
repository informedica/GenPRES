{
    "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
    "tasks": [
        {
            "name": "format-staged",
            "group": "pre-commit",
            "command": "sh",
            "args": [
                ".husky/scripts/format-staged.sh",
                "${staged}"
            ],
            "//include": "Every tracked .fs file, which is what CI's `dotnet fantomas --check .` covers: an allowlist rather than **/*.fs so generated and vendored sources can never reach Fantomas. The FAKE build script's sources live under build/, which matches no src/tests prefix. Scripts are absent because .fantomasignore excludes *.fsx, so passing them only produced a skip message.",
            "include": [
                "src/**/*.fs",
                "tests/**/*.fs",
                "benchmark/**/*.fs",
                "build/**/*.fs"
            ],
            "exclude": [
                "**/obj/**",
                "**/bin/**",
                "src/Informedica.GenPRES.Client/output/**"
            ]
        },
        {
            "name": "markdown-lint",
            "group": "pre-commit",
            "command": "dotnet",
            "args": [
                "fsi",
                ".husky/scripts/markdown-lint.fsx",
                "--",
                "${staged}"
            ],
            "include": [
                "**/*.md"
            ],
            "//exclude": "BenchmarkDotNet writes its result tables as Markdown and they are tracked, so linting them reports on output nobody writes by hand.",
            "exclude": [
                "benchmark/**/BenchmarkDotNet.Artifacts/**",
                "**/obj/**",
                "**/bin/**",
                "src/Informedica.GenPRES.Client/output/**"
            ]
        },
        {
            "name": "commit-message-linter",
            "group": "commit-msg",
            "command": "dotnet",
            "args": [
                "dotnet",
                "fsi",
                ".husky/scripts/commit-lint.fsx",
                "--",
                "${args}"
            ]
        }
    ]
}
