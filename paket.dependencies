// Main: the shipped libraries under src/, the server and the shared contract.
// Client-, test-, build- and benchmark-only packages live in their own groups
// below so that their transitive trees never influence the Main resolution
// (the pattern introduced for BenchmarkDotNet in issue #513).
source https://api.nuget.org/v3/index.json
framework: net10.0
storage: none

nuget FSharp.Core 10.1.203
nuget FSharpPlus 1.9.1

nuget Saturn ~> 0
// Fable.Remoting.Giraffe 6.1.0 recompiled against the task-based
// HttpHandler rewrite (Giraffe 7+) and requires Giraffe >= 8.2.0, so the
// earlier L1 hard pin (Giraffe = 6.4.0) is no longer needed. See the
// Update — 2026-04-18 section of docs/security/2026-04-10-security-review.md.
nuget Giraffe
nuget Fable.Remoting.Giraffe

nuget FSharp.Data
nuget HtmlAgilityPack 1.12.4
nuget FParsec
nuget FsToolkit.ErrorHandling 5.2.0
nuget MathNet.Numerics.FSharp
nuget NJsonSchema 11.6.1
nuget Validus
nuget Markdig 1.1.3
nuget ConsoleTables
nuget IcedTasks 0.11.9
nuget Unquote

nuget ModelContextProtocol 1.2.0
nuget Microsoft.Extensions.Hosting

// The session store's test and development database (ADR-0007 section 4, plan 516).
// Production never opens it.
nuget Microsoft.Data.Sqlite ~> 10
// Paket takes the newest transitive version; Microsoft.Data.Sqlite 10 is built against
// SQLitePCLRaw 2.1, and 3.x is a breaking major, so the bundle, its core and its native
// library stay on 2.1, the versions NuGet itself would pick.
nuget SQLitePCLRaw.bundle_e_sqlite3 ~> 2.1.12
nuget SQLitePCLRaw.core ~> 2.1.12
nuget SQLitePCLRaw.lib.e_sqlite3 ~> 2.1.12

// Serilog: the sink technology behind the Logger/Event/Level/IMessage port (#416). Referenced
// only by the composition roots (Informedica.GenPRES.Server, Informedica.MCP.Server,
// Informedica.MCP.Lib) — no core or adapter library references Serilog.
nuget Serilog 4.4.0
nuget Serilog.Sinks.Console 6.1.1
nuget Serilog.Sinks.File 7.0.0
nuget Serilog.Sinks.Async 2.1.0

// Fable / Elmish / Feliz packages, referenced only by Informedica.GenPRES.Client.
group Client
  source https://api.nuget.org/v3/index.json
  framework: net10.0
  storage: none

  // Same pin as Main, so that the copy this group provides agrees with the
  // copy that flows in from Main through project references.
  nuget FSharp.Core 10.1.203
  nuget Fable.Core 5.0.0
  nuget Fable.Remoting.Client
  nuget Fable.Browser.DOM
  nuget Fable.Elmish
  nuget Fable.Elmish.React 5.6.0
  nuget Fable.Elmish.Debugger
  nuget Fable.Elmish.HMR 9.0.0
  nuget Fable.React.UseElmish
  nuget Fable.Mocha
  nuget Fable.SimpleHttp

  nuget Feliz ~> 3
  nuget Feliz.UseElmish
  nuget Feliz.Markdown 3.1.0

// Test framework and test host, referenced only by the projects under tests/.
// Unquote stays in Main because the libraries use it too.
group Test
  source https://api.nuget.org/v3/index.json
  framework: net10.0
  storage: none

  // Same pin as Main, so that the copy this group provides agrees with the
  // copy that flows in from Main through project references.
  nuget FSharp.Core 10.1.203
  nuget Expecto ~> 10
  nuget Expecto.FsCheck
  nuget Microsoft.Net.Test.Sdk 18.4.0
  nuget YoloDev.Expecto.TestSdk 0.15.5

// FAKE build script (the root Build.fsproj, run with `dotnet run <target>`).
group Build
  source https://api.nuget.org/v3/index.json
  framework: net10.0
  storage: none

  // Same pin as Main, so that the copy this group provides agrees with the
  // copy that flows in from Main through project references.
  nuget FSharp.Core 10.1.203
  nuget Fake.Core.Target 6.1.4
  nuget Fake.IO.FileSystem 6.1.4
  nuget FsToolkit.ErrorHandling 5.2.0

// Benchmark suite (benchmark/, excluded from GenPRES.sln). Kept in its own group so that
// BenchmarkDotNet's transitive tree never influences the Main resolution. See issue #513.
group Benchmark
  source https://api.nuget.org/v3/index.json
  framework: net10.0
  storage: none

  nuget BenchmarkDotNet
