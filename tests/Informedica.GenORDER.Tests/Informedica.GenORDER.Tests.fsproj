<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <WarnOn>3390;$(WarnOn)</WarnOn>
    <!-- the tests run in parallel and allocate heavily; one heap per core keeps them from waiting on the GC -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- temp fix for: https://github.com/fsprojects/Paket/issues/4307 -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Scenarios.fs" />
    <Compile Include="GoldenOrders.fs" />
    <Compile Include="TotalsGolden.fs" />
    <Compile Include="OrderPlanTests.fs" />
    <Compile Include="OrderReopenTests.fs" />
    <Compile Include="FilterFixtures.fs" />
    <Compile Include="FilterCommandTests.fs" />
    <Compile Include="OrderValueCommandTests.fs" />
    <Compile Include="DomainCommandTests.fs" />
    <Compile Include="MedicationTextTests.fs" />
    <Compile Include="MedicationSchemaTests.fs" />
    <Compile Include="DoseQuantityPercTests.fs" />
    <Compile Include="Tests.fs" />
    <Compile Include="OrderReCalcTests.fs" />
    <Compile Include="OrderSetTests.fs" />
    <Compile Include="OrderLawsTests.fs" />
    <Compile Include="Main.fs" />
    <None Include="Scripts\load.fsx" />
    <Content Include="..\..\docs\domain\medication.schema.json" Link="medication.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Informedica.GenORDER.Lib\Informedica.GenORDER.Lib.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>