<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- temp fix for: https://github.com/fsprojects/Paket/issues/4307 -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- the browser and the app under test -->
    <Compile Include="Browser.fs" />
    <Compile Include="Wire.fs" />
    <Compile Include="StubLaunch.fs" />
    <Compile Include="StubMail.fs" />
    <Compile Include="Client.fs" />
    <Compile Include="Steps.fs" />

    <!-- the tests, one file per use case of docs/scenarios/integration -->
    <Compile Include="LaunchTests.fs" />
    <Compile Include="SessionTests.fs" />
    <Compile Include="AuthorityWithdrawnTests.fs" />
    <Compile Include="DirectOpenTests.fs" />
    <Compile Include="EnrolmentTests.fs" />
    <Compile Include="SigningTests.fs" />
    <Compile Include="HeldContextTests.fs" />
    <Compile Include="TwoUsersTests.fs" />
    <Compile Include="ReaderTests.fs" />
    <Compile Include="SessionEndingTests.fs" />
    <Compile Include="WorkstationTakeoverTests.fs" />
    <Compile Include="Suite.fs" />

    <Compile Include="Main.fs" />
  </ItemGroup>

  <!-- No ProjectReference: the tests reach the app through a browser only, as a user does. -->
  <Import Project="..\..\.paket\Paket.Restore.targets" />

</Project>
