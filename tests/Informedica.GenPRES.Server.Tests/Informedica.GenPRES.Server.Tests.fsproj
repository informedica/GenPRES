<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateProgramFile>false</GenerateProgramFile>
    <TargetFramework>net10.0</TargetFramework>
    <!-- temp fix for: https://github.com/fsprojects/Paket/issues/4307 -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ResourceErrorTests.fs" />
    <Compile Include="../Informedica.GenORDER.Tests/Scenarios.fs" />
    <Compile Include="StubAdapterTests.fs" />
    <Compile Include="DoseCheckTests.fs" />
    <Compile Include="TotalsTests.fs" />
    <Compile Include="NutritionRuleSetsTests.fs" />
    <Compile Include="MappersPatientTests.fs" />
    <Compile Include="MappersOrderContextTests.fs" />
    <Compile Include="MappersOrderPlanTests.fs" />
    <Compile Include="OrderContextSwitchTests.fs" />
    <Compile Include="OrderPlanSwitchTests.fs" />
    <Compile Include="SessionStoreTests.fs" />
    <Compile Include="SqlSchemaTests.fs" />
    <Compile Include="SqlRecordTests.fs" />
    <Compile Include="AgreementTests.fs" />
    <Compile Include="HttpTests.fs" />
    <Compile Include="ConfigTests.fs" />
    <Compile Include="Program.fs" />
    <Content Include="fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Scripts/load.fsx" />
    <None Include="Scripts/Tests.fsx" />
    <None Include="Scripts\Tests2.fsx" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Informedica.GenPRES.Server\Informedica.GenPRES.Server.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>