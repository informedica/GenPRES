<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- temp fix for: https://github.com/fsprojects/Paket/issues/4307 -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- the rest -->
    <Compile Include="DeferredTests.fs" />
    <Compile Include="TermTextTests.fs" />

    <!-- policies over the contract alone -->
    <Compile Include="LanguagePolicyTests.fs" />
    <Compile Include="OrderContextRefusalPolicyTests.fs" />
    <Compile Include="PatientDraftPolicyTests.fs" />
    <Compile Include="PatientReadinessTests.fs" />
    <Compile Include="PatientMachineTests.fs" />
    <Compile Include="PickPolicyTests.fs" />
    <Compile Include="StepPolicyTests.fs" />
    <Compile Include="SeverityReasonPolicyTests.fs" />
    <Compile Include="QuantityModePolicyTests.fs" />
    <Compile Include="IntakePolicyTests.fs" />
    <Compile Include="FieldOpenPolicyTests.fs" />
    <Compile Include="PickListTests.fs" />
    <Compile Include="SectionFoldPolicyTests.fs" />
    <Compile Include="TotalsChangePolicyTests.fs" />
    <Compile Include="PlanWorkPolicyTests.fs" />
    <Compile Include="HeldContextPolicyTests.fs" />
    <Compile Include="ServerErrorPolicyTests.fs" />

    <!-- the session and signing machines -->
    <Compile Include="SessionMachineTests.fs" />
    <Compile Include="SigningMachineTests.fs" />

    <!-- policies over the session and signing machines -->
    <Compile Include="SessionGatePolicyTests.fs" />
    <Compile Include="SigningPolicyTests.fs" />
    <Compile Include="UnsignedWorkPolicyTests.fs" />
    <Compile Include="HeldPanelPolicyTests.fs" />

    <!-- the order machines -->
    <Compile Include="OrderPlanMachineTests.fs" />
    <Compile Include="OrderContextMachineTests.fs" />
    <Compile Include="LanesTests.fs" />
    <Compile Include="BusyTests.fs" />
    <Compile Include="StartupPolicyTests.fs" />
    <Compile Include="UrlPolicyTests.fs" />

    <!-- policies over the contract alone, whose tests read the order plan machine's fixtures -->
    <Compile Include="ArgumentationPolicyTests.fs" />
    <Compile Include="DialogTabPolicyTests.fs" />
    <Compile Include="PlanContextPolicyTests.fs" />
    <Compile Include="PlanCellPolicyTests.fs" />

    <!-- the readable trail of the machines -->
    <Compile Include="TrailTests.fs" />

    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared comes with it: Client.Core references the contract, and the tests open both. -->
    <ProjectReference Include="..\..\src\Informedica.GenPRES.Client.Core\Informedica.GenPRES.Client.Core.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />

</Project>
